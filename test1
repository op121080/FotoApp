// --- Firebase Initialization ---
const firebaseConfig = typeof __firebase_config !== 'undefined' 
  ? JSON.parse(__firebase_config) 
  : {
      apiKey: "demo-api-key",
      authDomain: "demo-app.firebaseapp.com",
      projectId: "demo-app",
      storageBucket: "demo-app.app休.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:123456789"
    };

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'birthday-party-photo-wall';

export default function App() {
  // State variables
  const [user, setUser] = useState(null);
  const [photos, setPhotos] = useState([]);
  const [loading, setLoading] = useState(true);
  
  // UI Modals / Views
  const [showUploadModal, setShowUploadModal] = useState(false);
  const [showQRModal, setShowQRModal] = useState(false);
  const [showSlideshow, setShowSlideshow] = useState(false);
  const [selectedPhoto, setSelectedPhoto] = useState(null); // Lightbox
  const [searchQuery, setSearchQuery] = useState('');
  const [likedPhotos, setLikedPhotos] = useState({});

  // QR Code URL Customization State
  const [customPartyUrl, setCustomPartyUrl] = useState(() => typeof window !== 'undefined' ? window.location.href : '');

  // Upload Form State
  const [guestName, setGuestName] = useState(() => typeof window !== 'undefined' ? (localStorage.getItem('party_guest_name') || '') : '');
  const [caption, setCaption] = useState('');
  const [selectedImage, setSelectedImage] = useState(null);
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Slideshow State
  const [slideshowIndex, setSlideshowIndex] = useState(0);
  const [isPlayingSlideshow, setIsPlayingSlideshow] = useState(true);
  const [copiedLink, setCopiedLink] = useState(false);

  // Synchronize default URL if window location changes
  useEffect(() => {
    if (showQRModal && !customPartyUrl && typeof window !== 'undefined') {
      setCustomPartyUrl(window.location.href);
    }
  }, [showQRModal, customPartyUrl]);

  // Auth Initialization
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth initialization error:", err);
      }
    };
    initAuth();

    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
    });
    return () => unsubscribe();
  }, []);

  // Firestore Realtime Listener
  useEffect(() => {
    if (!user) return;

    // Strict path for public app data
    const photosCollection = collection(db, 'artifacts', appId, 'public', 'data', 'party_photos');

    const unsubscribe = onSnapshot(
      photosCollection,
      (snapshot) => {
        const loadedPhotos = snapshot.docs.map((docSnap) => ({
          id: docSnap.id,
          ...docSnap.data()
        }));

        // Sort by timestamp descending (newest first) in JS memory
        loadedPhotos.sort((a, b) => {
          const timeA = a.createdAt?.seconds || 0;
          const timeB = b.createdAt?.seconds || 0;
          return timeB - timeA;
        });

        setPhotos(loadedPhotos);
        setLoading(false);
      },
      (error) => {
        console.error("Error fetching photos:", error);
        setLoading(false);
      }
    );

    return () => unsubscribe();
  }, [user]);

  // Handle Local Storage for Guest Name
  useEffect(() => {
    if (guestName && typeof window !== 'undefined') {
      localStorage.setItem('party_guest_name', guestName);
    }
  }, [guestName]);

  // Slideshow Timer
  useEffect(() => {
    let interval = null;
    if (showSlideshow && isPlayingSlideshow && photos.length > 0) {
      interval = setInterval(() => {
        setSlideshowIndex((prevIndex) => (prevIndex + 1) % photos.length);
      }, 4000);
    }
    return () => clearInterval(interval);
  }, [showSlideshow, isPlayingSlideshow, photos.length]);

  // Compress & Handle Image Upload
  const handleImageSelect = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX_WIDTH = 1024;
        const MAX_HEIGHT = 1024;
        let width = img.width;
        let height = img.height;

        if (width > height) {
          if (width > MAX_WIDTH) {
            height *= MAX_WIDTH / width;
            width = MAX_WIDTH;
          }
        } else {
          if (height > MAX_HEIGHT) {
            width *= MAX_HEIGHT / height;
            height = MAX_HEIGHT;
          }
        }

        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        // Convert to Base64 (Data URL) for easy Firestore storage without Storage Bucket dependency
        const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
        setSelectedImage(dataUrl);
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  };

  // Submit Photo Post
  const handlePostSubmit = async (e) => {
    e.preventDefault();
    if (!selectedImage || !guestName.trim()) return;

    setIsSubmitting(true);
    try {
      const photosCollection = collection(db, 'artifacts', appId, 'public', 'data', 'party_photos');
      await addDoc(photosCollection, {
        imageUrl: selectedImage,
        guestName: guestName.trim(),
        caption: caption.trim(),
        likes: 0,
        createdAt: serverTimestamp(),
        userId: user ? user.uid : 'anonymous'
      });

      setSelectedImage(null);
      setCaption('');
      setShowUploadModal(false);
    } catch (err) {
      console.error("Error submitting post:", err);
    } finally {
      setIsSubmitting(false);
    }
  };

  // Handle Like Button Action
  const handleLike = async (photoId) => {
    if (likedPhotos[photoId]) return; // Prevent double liking in current session

    setLikedPhotos((prev) => ({ ...prev, [photoId]: true }));
    try {
      const photoRef = doc(db, 'artifacts', appId, 'public', 'data', 'party_photos', photoId);
      await updateDoc(photoRef, {
        likes: increment(1)
      });
    } catch (err) {
      console.error("Error updating likes:", err);
    }
  };

  // Filtered Photos by Guest Name or Caption
  const filteredPhotos = photos.filter((p) => {
    const q = searchQuery.toLowerCase();
    return (
      p.guestName?.toLowerCase().includes(q) ||
      p.caption?.toLowerCase().includes(q)
    );
  });

  // Download All Photos (Export for Host)
  const handleExportPhotos = () => {
    if (photos.length === 0) return;

    const galleryHtml = `
      <!DOCTYPE html>
      <html>
      <head>
        <title>Geburtstagsparty - Erinnerungsalbum</title>
        <style>
          body { font-family: sans-serif; background: #0f172a; color: #fff; padding: 20px; text-align: center; }
          h1 { color: #f59e0b; }
          .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 30px; }
          .card { background: #1e293b; border-radius: 12px; overflow: hidden; padding: 15px; border: 1px solid #334155; }
          img { width: 100%; height: 250px; object-fit: cover; border-radius: 8px; }
          .caption { margin-top: 10px; font-size: 14px; text-align: left; }
          .author { font-weight: bold; color: #f59e0b; }
        </style>
      </head>
      <body>
        <h1>🎉 Party-Erinnerungsalbum 🎉</h1>
        <p>Gesammelt am ${new Date().toLocaleDateString('de-DE')}</p>
        <div class="grid">
          ${photos.map(p => `
            <div class="card">
              <img src="${p.imageUrl}" alt="Party Foto" />
              <div class="caption">
                <div class="author">👤 ${p.guestName || 'Anonym'}</div>
                <p>${p.caption || ''}</p>
                <small>❤️ ${p.likes || 0} Likes</small>
              </div>
            </div>
          `).join('')}
        </div>
      </body>
      </html>
    `;

    const blob = new Blob([galleryHtml], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Party_Erinnerungen_${new Date().toISOString().slice(0, 10)}.html`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans pb-20 md:pb-6">
      
      {/* --- Top Header Navigation --- */}
      <header className="sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 py-3 shadow-lg">
        <div className="max-w-4xl mx-auto flex items-center justify-between">
          <div className="flex items-center gap-2">
            <div className="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 p-0.5 flex items-center justify-center shadow-amber-500/20 shadow-lg">
              <div className="w-full h-full bg-slate-950 rounded-full flex items-center justify-center">
                <Sparkles className="w-5 h-5 text-amber-400 animate-pulse" />
              </div>
            </div>
            <div>
              <h1 className="font-bold text-lg leading-tight bg-gradient-to-r from-amber-200 via-rose-300 to-amber-400 bg-clip-text text-transparent">
                PartyMoments 🎉
              </h1>
              <p className="text-xs text-slate-400">Geburtstag Live-Fotoalbum</p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => setShowQRModal(true)}
              className="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 hover:bg-slate-700 transition flex items-center gap-1.5 text-xs font-medium border border-slate-700"
              title="QR-Code für Gäste anzeigen"
            >
              <QrCode className="w-4 h-4" />
              <span className="hidden sm:inline">QR Code</span>
            </button>

            <button
              onClick={() => setShowSlideshow(true)}
              className="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 hover:bg-slate-700 transition flex items-center gap-1.5 text-xs font-medium border border-slate-700"
              title="Diashow für Beamer / TV"
            >
              <Tv className="w-4 h-4" />
              <span className="hidden sm:inline">Beamer Modus</span>
            </button>

            <button
              onClick={handleExportPhotos}
              className="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 hover:bg-slate-700 transition flex items-center gap-1.5 text-xs font-medium border border-slate-700"
              title="Alle Fotos speichern"
            >
              <Download className="w-4 h-4" />
              <span className="hidden sm:inline">Export</span>
            </button>
          </div>
        </div>
      </header>

      {/* --- Main Content Area --- */}
      <main className="flex-1 max-w-2xl w-full mx-auto px-4 py-6">
        
        {/* Banner Announcement */}
        <div className="mb-6 p-4 rounded-2xl bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-rose-500/10 border border-amber-500/20 text-center relative overflow-hidden shadow-inner">
          <h2 className="text-lg font-semibold text-amber-300 mb-1">
            Teile deine schönsten Party-Momente! 📸
          </h2>
          <p className="text-xs text-slate-300 max-w-md mx-auto">
            Knipst Fotos, hinterlasst Wünsche und helft mit, diesen Geburtstag unvergesslich zu machen!
          </p>
        </div>

        {/* Search & Filter Bar */}
        <div className="mb-6 flex gap-2">
          <div className="relative flex-1">
            <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <input
              type="text"
              placeholder="Suche nach Gast oder Nachricht..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-slate-900 border border-slate-800 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-500/50 transition"
            />
            {searchQuery && (
              <button
                onClick={() => setSearchQuery('')}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200"
              >
                <X className="w-4 h-4" />
              </button>
            )}
          </div>
        </div>

        {/* --- Feed / Photos List --- */}
        {loading ? (
          <div className="flex flex-col items-center justify-center py-16 gap-3 text-slate-400">
            <div className="w-8 h-8 border-4 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
            <p className="text-sm">Fotos werden geladen...</p>
          </div>
        ) : filteredPhotos.length === 0 ? (
          <div className="text-center py-16 px-4 rounded-2xl bg-slate-900/50 border border-slate-800/80">
            <div className="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-500">
              <Camera className="w-8 h-8" />
            </div>
            <h3 className="text-base font-semibold text-slate-300 mb-1">
              {searchQuery ? 'Keine Treffer gefunden' : 'Noch keine Party-Fotos da!'}
            </h3>
            <p className="text-xs text-slate-500 mb-6 max-w-xs mx-auto">
              {searchQuery 
                ? 'Versuche einen anderen Suchbegriff.' 
                : 'Sei der Erste und teile den ersten Schnappschuss des Abends.'}
            </p>
            {!searchQuery && (
              <button
                onClick={() => setShowUploadModal(true)}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-rose-500 font-medium text-slate-950 hover:brightness-110 shadow-lg shadow-amber-500/20 transition text-sm"
              >
                <Plus className="w-4 h-4" /> Jetzt Foto hochladen
              </button>
            )}
          </div>
        ) : (
          <div className="flex flex-col gap-6">
            {filteredPhotos.map((photo) => (
              <article
                key={photo.id}
                className="bg-slate-900/90 rounded-2xl border border-slate-800/80 overflow-hidden shadow-xl transition hover:border-slate-700"
              >
                {/* Post Header */}
                <div className="p-4 flex items-center justify-between border-b border-slate-800/50">
                  <div className="flex items-center gap-3">
                    <div className="w-9 h-9 rounded-full bg-gradient-to-tr from-amber-400 to-rose-500 p-0.5">
                      <div className="w-full h-full bg-slate-900 rounded-full flex items-center justify-center text-amber-300 font-bold text-sm">
                        {photo.guestName ? photo.guestName.charAt(0).toUpperCase() : '?'}
                      </div>
                    </div>
                    <div>
                      <h4 className="font-semibold text-sm text-slate-200 leading-tight">
                        {photo.guestName || 'Anonymer Gast'}
                      </h4>
                      <p className="text-[10px] text-slate-500">
                        {photo.createdAt?.seconds 
                          ? new Date(photo.createdAt.seconds * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                          : 'Gerade eben'}
                      </p>
                    </div>
                  </div>

                  <button
                    onClick={() => setSelectedPhoto(photo)}
                    className="p-1.5 text-slate-400 hover:text-slate-200 transition rounded-lg hover:bg-slate-800"
                    title="Vollbild anzeigen"
                  >
                    <Maximize2 className="w-4 h-4" />
                  </button>
                </div>

                {/* Post Image */}
                <div 
                  className="relative bg-slate-950 aspect-square overflow-hidden cursor-pointer group"
                  onClick={() => setSelectedPhoto(photo)}
                >
                  <img
                    src={photo.imageUrl}
                    alt={`Party Foto von ${photo.guestName}`}
                    className="w-full h-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                {/* Post Actions & Caption */}
                <div className="p-4">
                  <div className="flex items-center justify-between mb-3">
                    <button
                      onClick={() => handleLike(photo.id)}
                      className={`flex items-center gap-2 px-3 py-1.5 rounded-full border transition ${
                        likedPhotos[photo.id]
                          ? 'bg-rose-500/20 border-rose-500/40 text-rose-400'
                          : 'bg-slate-800/60 border-slate-700/60 text-slate-300 hover:text-rose-400 hover:bg-slate-800'
                      }`}
                    >
                      <Heart 
                        className={`w-4 h-4 ${likedPhotos[photo.id] ? 'fill-rose-500 text-rose-500' : ''}`} 
                      />
                      <span className="text-xs font-semibold">{photo.likes || 0}</span>
                    </button>
                  </div>

                  {photo.caption && (
                    <p className="text-sm text-slate-300 leading-relaxed">
                      <span className="font-semibold text-amber-200 mr-2">{photo.guestName}</span>
                      {photo.caption}
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </main>

      {/* --- Floating Action Button (Mobile First) --- */}
      <div className="fixed bottom-6 left-1/2 -translate-x-1/2 z-20">
        <button
          onClick={() => setShowUploadModal(true)}
          className="flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 text-slate-950 font-bold shadow-2xl shadow-amber-500/30 hover:scale-105 transition transform active:scale-95 border border-amber-300/40"
        >
          <Camera className="w-5 h-5 text-slate-950 stroke-[2.5]" />
          <span className="text-sm tracking-wide">Foto Knipsen</span>
        </button>
      </div>

      {/* --- UPLOAD MODAL --- */}
      {showUploadModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md overflow-hidden shadow-2xl animate-in fade-in zoom-in-95 duration-200">
            {/* Modal Header */}
            <div className="p-4 border-b border-slate-800 flex items-center justify-between">
              <h3 className="font-bold text-slate-200 flex items-center gap-2">
                <Camera className="w-5 h-5 text-amber-400" /> Party-Moment teilen
              </h3>
              <button
                onClick={() => {
                  setShowUploadModal(false);
                  setSelectedImage(null);
                }}
                className="p-1 text-slate-400 hover:text-slate-200 rounded-lg hover:bg-slate-800"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Modal Form */}
            <form onSubmit={handlePostSubmit} className="p-5 flex flex-col gap-4">
              {/* Image Picker / Preview */}
              <div>
                <label className="block text-xs font-medium text-slate-400 mb-2">
                  Foto auswählen oder aufnehmen
                </label>
                {selectedImage ? (
                  <div className="relative aspect-video rounded-xl overflow-hidden bg-slate-950 border border-slate-800 group">
                    <img
                      src={selectedImage}
                      alt="Vorschau"
                      className="w-full h-full object-cover"
                    />
                    <button
                      type="button"
                      onClick={() => setSelectedImage(null)}
                      className="absolute top-2 right-2 p-1.5 bg-slate-950/80 text-slate-200 rounded-full hover:bg-rose-600 transition"
                      title="Foto entfernen"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                ) : (
                  <label className="flex flex-col items-center justify-center h-40 border-2 border-dashed border-slate-700 hover:border-amber-500/50 rounded-xl cursor-pointer bg-slate-950/50 hover:bg-slate-950 transition p-4 text-center">
                    <ImageIcon className="w-10 h-10 text-slate-500 mb-2" />
                    <span className="text-xs font-medium text-amber-400 mb-1">
                      Klicke zum Auswählen oder Kamera öffnen
                    </span>
                    <span className="text-[10px] text-slate-500">
                      JPG, PNG unterstützt
                    </span>
                    <input
                      type="file"
                      accept="image/*"
                      onChange={handleImageSelect}
                      className="hidden"
                    />
                  </label>
                )}
              </div>

              {/* Guest Name */}
              <div>
                <label className="block text-xs font-medium text-slate-400 mb-1">
                  Dein Name / Name des Gastes *
                </label>
                <div className="relative">
                  <User className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" />
                  <input
                    type="text"
                    required
                    placeholder="z.B. Lisa & Tom"
                    value={guestName}
                    onChange={(e) => setGuestName(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-amber-500 transition"
                  />
                </div>
              </div>

              {/* Caption / Wishes */}
              <div>
                <label className="block text-xs font-medium text-slate-400 mb-1">
                  Nachricht / Glückwunsch
                </label>
                <div className="relative">
                  <MessageSquare className="w-4 h-4 absolute left-3 top-3 text-slate-500" />
                  <textarea
                    rows="3"
                    placeholder="Schreibe einen kurzen Text oder Glückwunsch..."
                    value={caption}
                    onChange={(e) => setCaption(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-500 transition resize-none"
                  ></textarea>
                </div>
              </div>

              {/* Submit Button */}
              <button
                type="submit"
                disabled={!selectedImage || !guestName.trim() || isSubmitting}
                className="mt-2 w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-rose-500 font-bold text-slate-950 shadow-lg shadow-amber-500/20 hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed transition flex items-center justify-center gap-2 text-sm"
              >
                {isSubmitting ? (
                  <div className="w-5 h-5 border-2 border-slate-950 border-t-transparent rounded-full animate-spin" />
                ) : (
                  <>
                    <Sparkles className="w-4 h-4" /> Foto Veröffentlichen
                  </>
                )}
              </button>
            </form>
          </div>
        </div>
      )}

      {/* --- QR CODE MODAL --- */}
      {showQRModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm p-6 text-center shadow-2xl relative">
            <button
              onClick={() => setShowQRModal(false)}
              className="absolute top-3 right-3 p-1 text-slate-400 hover:text-slate-200 rounded-lg"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="w-12 h-12 bg-amber-500/10 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-3 text-amber-400">
              <QrCode className="w-6 h-6" />
            </div>

            <h3 className="font-bold text-slate-100 text-lg mb-1">Party-QR Code</h3>
            <p className="text-xs text-slate-400 mb-4">
              Scanne den Code mit der Smartphone-Kamera, um direkt zum Fotoalbum zu gelangen!
            </p>

            {/* Real QuickChart / Google API Scanable QR Code Image */}
            <div className="bg-white p-3 rounded-2xl shadow-lg inline-block border-4 border-amber-400/40 mb-4">
              <img 
                src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(customPartyUrl || (typeof window !== 'undefined' ? window.location.href : ''))}`} 
                alt="Scanbarer Party QR-Code"
                className="w-48 h-48 rounded-lg"
              />
            </div>

            {/* Custom URL Input for Host */}
            <div className="mb-4 text-left">
              <label className="block text-[11px] text-slate-400 mb-1 font-medium">
                Ziel-Webadresse (URL für die Gäste):
              </label>
              <div className="relative">
                <LinkIcon className="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" />
                <input
                  type="url"
                  value={customPartyUrl}
                  onChange={(e) => setCustomPartyUrl(e.target.value)}
                  placeholder="https://deine-party-app.de"
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-300 focus:outline-none focus:border-amber-500"
                />
              </div>
            </div>

            <button
              onClick={() => {
                const targetUrl = customPartyUrl || (typeof window !== 'undefined' ? window.location.href : '');
                const fallbackCopyTextToClipboard = (text) => {
                  const textArea = document.createElement("textarea");
                  textArea.value = text;
                  textArea.style.top = "0";
                  textArea.style.left = "0";
                  textArea.style.position = "fixed";
                  document.body.appendChild(textArea);
                  textArea.focus();
                  textArea.select();
                  try {
                    document.execCommand('copy');
                    setCopiedLink(true);
                    setTimeout(() => setCopiedLink(false), 3000);
                  } catch (e) {
                    console.error('Fallback: Kopieren fehlgeschlagen', e);
                  }
                  document.body.removeChild(textArea);
                };

                try {
                  if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(targetUrl).then(() => {
                      setCopiedLink(true);
                      setTimeout(() => setCopiedLink(false), 3000);
                    }).catch(() => {
                      fallbackCopyTextToClipboard(targetUrl);
                    });
                  } else {
                    fallbackCopyTextToClipboard(targetUrl);
                  }
                } catch (err) {
                  fallbackCopyTextToClipboard(targetUrl);
                }
              }}
              className="w-full py-2.5 rounded-xl bg-slate-800 text-slate-200 hover:bg-slate-700 font-medium text-xs border border-slate-700 flex items-center justify-center gap-2 transition"
            >
              {copiedLink ? (
                <>
                  <Check className="w-4 h-4 text-emerald-400" />
                  <span className="text-emerald-400">Link kopiert!</span>
                </>
              ) : (
                <>
                  <Share2 className="w-4 h-4" /> Party-Link kopieren
                </>
              )}
            </button>
          </div>
        </div>
      )}

      {/* --- SLIDESHOW / BEAMER MODUS MODAL --- */}
      {showSlideshow && (
        <div className="fixed inset-0 z-50 bg-slate-950 flex flex-col justify-between p-6">
          {/* Slideshow Top Controls */}
          <div className="flex items-center justify-between z-10">
            <div className="flex items-center gap-2">
              <Sparkles className="w-5 h-5 text-amber-400" />
              <span className="font-bold text-slate-200 text-sm">Party Live Presentation</span>
            </div>
            
            <div className="flex items-center gap-3">
              <button
                onClick={() => setIsPlayingSlideshow(!isPlayingSlideshow)}
                className="p-2 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-200 transition"
              >
                {isPlayingSlideshow ? <Pause className="w-5 h-5" /> : <Play className="w-5 h-5" />}
              </button>
              <button
                onClick={() => setShowSlideshow(false)}
                className="p-2 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-200 transition"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Slideshow Main Content */}
          {photos.length === 0 ? (
            <div className="text-center text-slate-500 my-auto">
              Noch keine Fotos für die Diashow vorhanden.
            </div>
          ) : (
            <div className="my-auto relative max-w-4xl mx-auto w-full flex flex-col items-center">
              <div className="relative aspect-video max-h-[70vh] rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-slate-900 w-full flex items-center justify-center">
                <img
                  src={photos[slideshowIndex]?.imageUrl}
                  alt="Slideshow"
                  className="max-w-full max-h-full object-contain"
                />
              </div>

              {/* Caption overlay */}
              <div className="mt-4 text-center max-w-xl">
                <h3 className="text-amber-300 font-bold text-lg">
                  {photos[slideshowIndex]?.guestName || 'Anonymer Gast'}
                </h3>
                {photos[slideshowIndex]?.caption && (
                  <p className="text-slate-300 text-sm mt-1">
                    "{photos[slideshowIndex]?.caption}"
                  </p>
                )}
              </div>
            </div>
          )}

          {/* Slideshow Navigation Footer */}
          {photos.length > 0 && (
            <div className="flex items-center justify-between max-w-md mx-auto w-full text-xs text-slate-500">
              <button
                onClick={() => setSlideshowIndex((slideshowIndex - 1 + photos.length) % photos.length)}
                className="p-2 text-slate-400 hover:text-slate-200"
              >
                <ChevronLeft className="w-6 h-6" />
              </button>
              <span>
                {slideshowIndex + 1} / {photos.length}
              </span>
              <button
                onClick={() => setSlideshowIndex((slideshowIndex + 1) % photos.length)}
                className="p-2 text-slate-400 hover:text-slate-200"
              >
                <ChevronRight className="w-6 h-6" />
              </button>
            </div>
          )}
        </div>
      )}

      {/* --- LIGHTBOX (FULLSCREEN IMAGE) MODAL --- */}
      {selectedPhoto && (
        <div 
          className="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4"
          onClick={() => setSelectedPhoto(null)}
        >
          <div 
            className="relative max-w-3xl w-full bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl"
            onClick={(e) => e.stopPropagation()}
          >
            <button
              onClick={() => setSelectedPhoto(null)}
              className="absolute top-3 right-3 z-10 p-2 bg-slate-950/70 text-slate-200 rounded-full hover:bg-slate-800 transition"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="aspect-square max-h-[70vh] bg-slate-950 flex items-center justify-center">
              <img
                src={selectedPhoto.imageUrl}
                alt="Full size"
                className="max-w-full max-h-full object-contain"
              />
            </div>

            <div className="p-4 bg-slate-900">
              <div className="flex items-center justify-between mb-2">
                <span className="font-bold text-amber-300 text-sm">
                  {selectedPhoto.guestName}
                </span>
                <div className="flex items-center gap-1 text-xs text-rose-400">
                  <Heart className="w-4 h-4 fill-rose-500" />
                  <span>{selectedPhoto.likes || 0}</span>
                </div>
              </div>
              {selectedPhoto.caption && (
                <p className="text-sm text-slate-300">{selectedPhoto.caption}</p>
              )}
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
